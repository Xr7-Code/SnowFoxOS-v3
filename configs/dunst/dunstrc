[global]
    monitor                = 0
    follow                 = mouse
    width                  = 320
    height                 = 100
    origin                 = top-right
    offset                 = 12x48
    scale                  = 0
    notification_limit     = 5
    progress_bar           = true
    progress_bar_height    = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden        = yes
    transparency           = 8
    separator_height       = 1
    padding                = 12
    horizontal_padding     = 14
    text_icon_padding      = 10
    frame_width            = 1
    frame_color            = "#8139e8"
    separator_color        = frame
    sort                   = yes
    font                   = Inter 11
    line_height            = 2
    markup                 = full
    format                 = "<b>%s</b>\n%b"
    alignment              = left
    vertical_alignment     = center
    show_age_threshold     = 60
    ellipsize              = middle
    ignore_newline         = no
    stack_duplicates       = true
    hide_duplicate_count   = false
    show_indicators        = yes
    icon_theme             = Papirus-Dark
    enable_recursive_icon_lookup = true
    icon_position          = left
    min_icon_size          = 0
    max_icon_size          = 32
    sticky_history         = yes
    history_length         = 20
    always_run_script      = true
    title                  = Dunst
    class                  = Dunst
    corner_radius          = 10
    ignore_dbusclose       = false
    force_xwayland         = false
    force_xinerama         = false
    mouse_left_click       = close_current
    mouse_middle_click     = do_action, close_current
    mouse_right_click      = close_all

[experimental]
    per_monitor_dpi = false

# ── Urgency-Stufen — alle auf SnowFox-Palette ────────────────
# low: gedimmt, kaum sichtbar
[urgency_low]
    background  = "#1e1e2e"
    foreground  = "#6c7086"
    frame_color = "#2a2a3e"
    timeout     = 4

# normal: volle Palette, lila Rand
[urgency_normal]
    background  = "#1e1e2e"
    foreground  = "#cdd6f4"
    frame_color = "#8139e8"
    timeout     = 6

# critical: roter Rand, sofort sichtbar
[urgency_critical]
    background  = "#1e1e2e"
    foreground  = "#cdd6f4"
    frame_color = "#e05555"
    timeout     = 0
