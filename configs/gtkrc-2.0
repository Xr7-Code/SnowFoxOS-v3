# ============================================================
#    SnowFoxOS v3 — GTK2 Override Config
#    Place at: ~/.gtkrc-2.0
#    Copyright (c) 2026 Alexander Valentin Ludwig (Xr7-Code)
# ============================================================
# Order rule: With equal priority, the LATER definition wins.
# Therefore: general first, specific last.

# ── Color Scheme Globals ───────────────────────────────────
gtk-color-scheme = "bg_color:#1a1825\nbg_alt_color:#201e2e\nbg_surface:#2a2840\nbg_hover:#332f50\nfg_color:#e0d9f5\nfg_dim_color:#6e6a8a\nbase_color:#1a1825\ntext_color:#e0d9f5\nselected_bg_color:#9d6fe8\nselected_fg_color:#ffffff\npurple_hover:#b899ff\npurple_active:#5c3d99\nborder_color:#2a2840\ntooltip_bg_color:#2a2840\ntooltip_fg_color:#e0d9f5\nlink_color:#b899ff"

# ── Global Base Style ──────────────────────────────────────
# ACTIVE = selection in a widget WITHOUT focus (e.g. window in
# background). Previously #332f50 -> barely visible. Now purple_active.
style "snowfox-colors" {
    base[NORMAL]      = "#1a1825"
    base[ACTIVE]      = "#5c3d99"
    base[PRELIGHT]    = "#1a1825"
    base[INSENSITIVE] = "#1a1825"
    base[SELECTED]    = "#9d6fe8"

    bg[NORMAL]        = "#2a2840"
    bg[ACTIVE]        = "#201e2e"
    bg[INSENSITIVE]   = "#1a1825"
    bg[SELECTED]      = "#9d6fe8"
    bg[PRELIGHT]      = "#332f50"

    text[NORMAL]      = "#e0d9f5"
    text[ACTIVE]      = "#ffffff"
    text[PRELIGHT]    = "#e0d9f5"
    text[SELECTED]    = "#ffffff"
    text[INSENSITIVE] = "#6e6a8a"

    fg[NORMAL]        = "#e0d9f5"
    fg[ACTIVE]        = "#ffffff"
    fg[SELECTED]      = "#ffffff"
    fg[PRELIGHT]      = "#ffffff"
    fg[INSENSITIVE]   = "#6e6a8a"

    engine "murrine" {
        contrast            = 0.0
        gradient_shades     = { 1.0, 1.0, 1.0, 1.0 }
        lightborder_shade   = 1.0
        border_shades       = { 1.0, 1.0 }
        focus_color         = "#b899ff"
    }
}

# ── Lists / File views (PCManFM main area) ────────────────
style "snowfox-view" {
    base[NORMAL]      = "#1a1825"
    base[ACTIVE]      = "#5c3d99"
    base[SELECTED]    = "#9d6fe8"
    bg[NORMAL]        = "#1a1825"
    text[NORMAL]      = "#e0d9f5"
    text[ACTIVE]      = "#ffffff"
    text[SELECTED]    = "#ffffff"

    GtkTreeView::even-row-color       = "#1a1825"
    GtkTreeView::odd-row-color        = "#1a1825"
    GtkTreeView::vertical-separator   = 4
    GtkTreeView::horizontal-separator = 4
}

# ── Multi-line text fields ─────────────────────────────────
style "snowfox-textview" {
    base[NORMAL]      = "#1a1825"
    base[ACTIVE]      = "#5c3d99"
    base[SELECTED]    = "#9d6fe8"
    text[NORMAL]      = "#e0d9f5"
    text[ACTIVE]      = "#ffffff"
    text[SELECTED]    = "#ffffff"
}

# ── Sidebar (PCManFM) ──────────────────────────────────────
style "snowfox-sidebar" {
    base[NORMAL]      = "#201e2e"
    base[ACTIVE]      = "#5c3d99"
    base[SELECTED]    = "#9d6fe8"
    bg[NORMAL]        = "#201e2e"
    bg[ACTIVE]        = "#332f50"
    bg[PRELIGHT]      = "#332f50"
    bg[SELECTED]      = "#9d6fe8"

    text[NORMAL]      = "#e0d9f5"
    text[ACTIVE]      = "#ffffff"
    text[SELECTED]    = "#ffffff"
    fg[NORMAL]        = "#e0d9f5"
    fg[PRELIGHT]      = "#ffffff"
    fg[SELECTED]      = "#ffffff"

    GtkScrolledWindow::shadow-type       = GTK_SHADOW_NONE
    GtkScrolledWindow::scrollbar-spacing = 0
    GtkTreeView::shadow-type             = GTK_SHADOW_NONE
    GtkTreeView::vertical-separator      = 5
    GtkTreeView::horizontal-separator    = 6

    engine "murrine" {
        contrast          = 0.0
        gradient_shades   = { 1.0, 1.0, 1.0, 1.0 }
        lightborder_shade = 1.0
        roundness         = 6
        focus_color       = "#201e2e"
    }
}

# ── Menu / toolbar bars ────────────────────────────────────
style "snowfox-bars" {
    bg[NORMAL]        = "#1a1825"
    bg[ACTIVE]        = "#201e2e"
    bg[PRELIGHT]      = "#2a2840"
    fg[NORMAL]        = "#e0d9f5"

    engine "murrine" {
        gradient_shades   = { 1.0, 1.0, 1.0, 1.0 }
        contrast          = 0.0
        lightborder_shade = 1.0
    }
}

# ── Tabs ───────────────────────────────────────────────────
style "snowfox-tabs" {
    bg[NORMAL]        = "#1a1825"
    bg[ACTIVE]        = "#2a2840"
    bg[PRELIGHT]      = "#332f50"
}

# ── Entry fields ───────────────────────────────────────────
style "snowfox-entry" {
    base[NORMAL]      = "#201e2e"
    base[ACTIVE]      = "#5c3d99"
    base[SELECTED]    = "#9d6fe8"
    text[NORMAL]      = "#e0d9f5"
    text[ACTIVE]      = "#ffffff"
    text[SELECTED]    = "#ffffff"

    engine "murrine" {
        contrast          = 0.0
        gradient_shades   = { 1.0, 1.0, 1.0, 1.0 }
        lightborder_shade = 1.0
        border_shades     = { 1.0, 1.0 }
        roundness         = 8
        focus_color       = "#b899ff"
    }
}

# ── Buttons ────────────────────────────────────────────────
style "snowfox-widgets" {
    bg[NORMAL]        = "#2a2840"
    bg[PRELIGHT]      = "#332f50"
    bg[ACTIVE]        = "#9d6fe8"
    fg[NORMAL]        = "#e0d9f5"
    fg[PRELIGHT]      = "#ffffff"
    fg[ACTIVE]        = "#ffffff"

    engine "murrine" {
        contrast          = 0.0
        gradient_shades   = { 1.0, 1.0, 1.0, 1.0 }
        lightborder_shade = 1.0
        glow_shade        = 1.0
        roundness         = 8
        focus_color       = "#b899ff"
    }
}

# ── Scrollbars ─────────────────────────────────────────────
style "snowfox-scrollbar" {
    bg[NORMAL]        = "#6e6a8a"
    bg[PRELIGHT]      = "#b899ff"
    bg[ACTIVE]        = "#9d6fe8"

    engine "murrine" {
        contrast          = 0.0
        gradient_shades   = { 1.0, 1.0, 1.0, 1.0 }
        roundness         = 10
        trough_shades     = { 1.0, 1.0 }
    }
}

# ── Separator (Paned) ──────────────────────────────────────
style "snowfox-separator" {
    bg[NORMAL]        = "#2a2840"
    bg[PRELIGHT]      = "#b899ff"
    bg[ACTIVE]        = "#9d6fe8"

    GtkPaned::handle-size = 2

    engine "murrine" {
        contrast          = 0.0
        gradient_shades   = { 1.0, 1.0, 1.0, 1.0 }
    }
}

# ── Menus ──────────────────────────────────────────────────
style "snowfox-menus" {
    base[NORMAL]      = "#2a2840"
    bg[NORMAL]        = "#2a2840"
    bg[PRELIGHT]      = "#9d6fe8"
    bg[SELECTED]      = "#9d6fe8"
    fg[NORMAL]        = "#e0d9f5"
    fg[PRELIGHT]      = "#ffffff"
    fg[SELECTED]      = "#ffffff"
    text[NORMAL]      = "#e0d9f5"
    text[PRELIGHT]    = "#ffffff"

    engine "murrine" {
        gradient_shades   = { 1.0, 1.0, 1.0, 1.0 }
        contrast          = 0.0
        roundness         = 6
    }
}

# ── Tooltips ───────────────────────────────────────────────
style "snowfox-tooltip" {
    bg[NORMAL]        = "#2a2840"
    fg[NORMAL]        = "#e0d9f5"
}

# ============================================================
#    Widget Assignments  (general -> specific)
# ============================================================

# Base for everything
class "GtkWidget"                    style "snowfox-colors"

# Lists, text fields
class "GtkTreeView"                  style "snowfox-view"
class "GtkIconView"                  style "snowfox-view"
class "GtkTextView"                  style "snowfox-textview"

# PCManFM main window / file view
widget_class "*FmFolderView*"        style "snowfox-view"

# Bars (before buttons, so toolbar buttons keep their button style)
class "GtkMenuBar"                   style "snowfox-bars"
class "GtkToolbar"                   style "snowfox-bars"
widget_class "*<GtkToolbar>*"        style "snowfox-bars"

# Controls
class "GtkNotebook"                  style "snowfox-tabs"
class "GtkEntry"                     style "snowfox-entry"
class "GtkButton"                    style "snowfox-widgets"
class "GtkScrollbar"                 style "snowfox-scrollbar"

# Sidebar (highest priority, so nothing overrides it)
widget_class "*FmSidePane*"          style:highest "snowfox-sidebar"
widget_class "*FmPlacesView*"        style:highest "snowfox-sidebar"
widget_class "*FmDirTreeView*"       style:highest "snowfox-sidebar"

# Separator: only the Paned itself, not its children
class "GtkPaned"                     style:highest "snowfox-separator"

# Menus
widget_class "*<GtkMenu>*"           style:highest "snowfox-menus"
widget_class "*<GtkMenuItem>*"       style:highest "snowfox-menus"

# Tooltips (GTK2 window names)
widget "gtk-tooltip*"                style "snowfox-tooltip"
widget "gtk-tooltips*"               style "snowfox-tooltip"
