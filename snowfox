cmd_webapp() {
    local WAPP_DIR="$HOME/.config/snowfox/webapps"
    local WAPP_JSON="$HOME/.config/snowfox/webapps.json"
    local WAPP_DESK="$HOME/.local/share/applications"
    local WAPP_ICONS="$HOME/.config/snowfox/webapps/icons"
    mkdir -p "$WAPP_DIR" "$WAPP_DESK" "$WAPP_ICONS"

    ACTION=$(whiptail --title "WebApps" --menu \
        "Wähle eine Aktion:" 14 50 4 \
        "add" "Neue WebApp erstellen" \
        "list" "Alle WebApps anzeigen" \
        "open" "WebApp starten" \
        "remove" "WebApp entfernen" 3>&1 1>&2 2>&3)

    case "$ACTION" in
        add)
            WA_NAME=$(whiptail --inputbox "Name der WebApp:" 10 60 3>&1 1>&2 2>&3)
            [[ -z "$WA_NAME" ]] && return
            WA_URL=$(whiptail --inputbox "URL der WebApp:" 10 60 3>&1 1>&2 2>&3)
            [[ -z "$WA_URL" ]] && return

            WA_SAFE=$(echo "$WA_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd '[:alnum:]-')
            WA_ICON="web-browser"
            WA_ICON_PATH="$WAPP_ICONS/${WA_SAFE}.png"
            WA_DOMAIN=$(echo "$WA_URL" | sed 's|https\?://||' | cut -d'/' -f1)

            FAVICON_URL="https://www.google.com/s2/favicons?domain=${WA_DOMAIN}&sz=128"
            curl -sfL --max-time 5 "$FAVICON_URL" -o "$WA_ICON_PATH" 2>/dev/null && \
                [[ -f "$WA_ICON_PATH" ]] && WA_ICON="$WA_ICON_PATH"

            WA_BR=$(whiptail --title "Browser wählen" --menu \
                "Wähle den Browser für die WebApp:" 16 60 6 \
                "1" "Helium (App-Modus, empfohlen)" \
                "2" "Helium (mit Addons)" \
                "3" "Zen Browser" \
                "4" "Chromium" \
                "5" "Brave" \
                "6" "Firefox-ESR" 3>&1 1>&2 2>&3)

            local WA_BIN WA_EXEC
            case "$WA_BR" in
                1) WA_BIN="$HOME/Applications/helium.AppImage"; WA_EXEC="$WA_BIN --app=$WA_URL --class=snowfox-webapp-$WA_SAFE" ;;
                2)
                    WA_BIN="$HOME/Applications/helium.AppImage"
                    WA_PROF="$WAPP_DIR/$WA_SAFE/profile"
                    mkdir -p "$WA_PROF"
                    WA_MAIN=$(find "$HOME/.config/net.imput.helium" -maxdepth 2 -name "Extensions" -type d 2>/dev/null | head -1)
                    [[ -n "$WA_MAIN" ]] && ln -sf "$WA_MAIN" "$WA_PROF/Extensions" 2>/dev/null || true
                    WA_EXEC="$WA_BIN --app=$WA_URL --user-data-dir=$WA_PROF --class=snowfox-webapp-$WA_SAFE"
                    ;;
                3) WA_BIN="/opt/zen-browser.AppImage"; WA_EXEC="$WA_BIN --app=$WA_URL --class=snowfox-webapp-$WA_SAFE" ;;
                4) WA_BIN="chromium"; WA_EXEC="$WA_BIN --app=$WA_URL --class=snowfox-webapp-$WA_SAFE" ;;
                5) WA_BIN="brave-browser"; WA_EXEC="$WA_BIN --app=$WA_URL --class=snowfox-webapp-$WA_SAFE" ;;
                6) WA_BIN="firefox-esr"; WA_EXEC="$WA_BIN --ssb=$WA_URL" ;;
                *) return ;;
            esac

            cat > "$WAPP_DESK/snowfox-webapp-${WA_SAFE}.desktop" << DEOF
[Desktop Entry]
Name=$WA_NAME
Comment=SnowFox WebApp — $WA_URL
Exec=$WA_EXEC
Icon=$WA_ICON
Type=Application
Categories=Network;WebApp;
StartupNotify=true
StartupWMClass=snowfox-webapp-$WA_SAFE
DEOF

            python3 -c "
import json, os
path = '$WAPP_JSON'
data = []
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except:
        data = []
data = [x for x in data if x.get('name') != '$WA_NAME']
data.append({'name':'$WA_NAME','url':'$WA_URL','safe':'$WA_SAFE','icon':'$WA_ICON'})
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null

            update-desktop-database "$WAPP_DESK" 2>/dev/null || true
            whiptail --msgbox "✅ WebApp '${WA_NAME}' erstellt\n\nStarte mit: snowfox webapp open $WA_SAFE" 10 60
            ;;

        list)
            if [[ ! -f "$WAPP_JSON" ]]; then
                whiptail --msgbox "Keine WebApps vorhanden." 8 40
                return
            fi
            LIST=$(python3 -c "
import json
with open('$WAPP_JSON') as f:
    data = json.load(f)
out = []
for i, a in enumerate(data, 1):
    out.append(f\"{i}. {a['name']}  →  {a['url']}\")
print('\n'.join(out))" 2>/dev/null)
            whiptail --msgbox "📋 WebApps:\n\n$LIST" 20 60
            ;;

        open)
            if [[ ! -f "$WAPP_JSON" ]]; then
                whiptail --msgbox "Keine WebApps vorhanden." 8 40
                return
            fi
            NAMES=$(python3 -c "
import json
with open('$WAPP_JSON') as f:
    data = json.load(f)
print(' '.join([a['name'] for a in data]))" 2>/dev/null)
            WA_NAME=$(whiptail --inputbox "Name der WebApp:\n\nVorhanden: $NAMES" 12 60 3>&1 1>&2 2>&3)
            [[ -z "$WA_NAME" ]] && return
            WA_SAFE2=$(echo "$WA_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd '[:alnum:]-')
            WA_DESK="$WAPP_DESK/snowfox-webapp-${WA_SAFE2}.desktop"
            if [[ ! -f "$WA_DESK" ]]; then
                whiptail --msgbox "WebApp '$WA_NAME' nicht gefunden." 8 40
                return
            fi
            WA_EXEC2=$(grep "^Exec=" "$WA_DESK" | cut -d= -f2-)
            eval "$WA_EXEC2" &
            whiptail --msgbox "✅ Öffne ${WA_NAME}..." 8 40
            ;;

        remove)
            if [[ ! -f "$WAPP_JSON" ]]; then
                whiptail --msgbox "Keine WebApps vorhanden." 8 40
                return
            fi
            NAMES=$(python3 -c "
import json
with open('$WAPP_JSON') as f:
    data = json.load(f)
print(' '.join([a['name'] for a in data]))" 2>/dev/null)
            WA_NAME=$(whiptail --inputbox "Name der zu löschenden WebApp:\n\nVorhanden: $NAMES" 12 60 3>&1 1>&2 2>&3)
            [[ -z "$WA_NAME" ]] && return
            WA_SAFE3=$(echo "$WA_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd '[:alnum:]-')
            rm -f "$WAPP_DESK/snowfox-webapp-${WA_SAFE3}.desktop"
            rm -rf "$WAPP_DIR/$WA_SAFE3"
            rm -f "$WAPP_ICONS/${WA_SAFE3}.png"
            python3 -c "
import json, os
path = '$WAPP_JSON'
if not os.path.exists(path): exit()
with open(path) as f:
    data = json.load(f)
data = [x for x in data if x.get('safe') != '$WA_SAFE3']
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null
            update-desktop-database "$WAPP_DESK" 2>/dev/null || true
            whiptail --msgbox "✅ WebApp '$WA_NAME' entfernt." 8 40
            ;;
    esac
}

# ============================================================
# snowfox apps (TUI)
# ============================================================
APPS_DESKTOP_DIRS=("/usr/share/applications" "$HOME/.local/share/applications")
APPS_CACHE_DIR="$HOME/.cache/snowfox"
APPS_LIST_FILE="$APPS_CACHE_DIR/apps.list"
APPS_PROTECTED=(i3 i3-wm i3status i3lock polybar rofi dunst xorg xserver-xorg-core xinit \
                x11-xserver-utils network-manager bluez systemd dbus pipewire pipewire-pulse \
                wireplumber kitty pcmanfm sudo)

_apps_is_protected() {
    local pkg="$1"
    for p in "${APPS_PROTECTED[@]}"; do
        [[ "$pkg" == "$p" ]] && return 0
    done
    return 1
}

_apps_build_list() {
    mkdir -p "$APPS_CACHE_DIR"
    > "$APPS_LIST_FILE"
    local count=1
    for dir in "${APPS_DESKTOP_DIRS[@]}"; do
        [[ -d "$dir" ]] || continue
        for file in "$dir"/*.desktop; do
            [[ -e "$file" ]] || continue
            grep -q "^NoDisplay=true" "$file" 2>/dev/null && continue
            app_name=$(grep -m1 "^Name=" "$file" | cut -d= -f2-)
            [[ -z "$app_name" ]] && app_name="$(basename "$file" .desktop)"
            file_name=$(basename "$file")
            package_name=$(dpkg -S "applications/$file_name" 2>/dev/null | cut -d: -f1 | head -1)
            [[ -z "$package_name" ]] && package_name="manual"
            echo "${count}|${app_name}|${package_name}|${file}" >> "$APPS_LIST_FILE"
            ((count++))
        done
    done
}

cmd_apps() {
    _apps_build_list

    # Hole Liste für whiptail menu
    MENU_ITEMS=()
    while IFS='|' read -r id name pkg _; do
        if _apps_is_protected "$pkg"; then
            MENU_ITEMS+=("$id" "$name (geschützt)")
        else
            MENU_ITEMS+=("$id" "$name")
        fi
    done < "$APPS_LIST_FILE"

    ACTION=$(whiptail --title "Apps" --menu \
        "Wähle eine Aktion:" 12 50 2 \
        "list" "Alle Apps anzeigen" \
        "remove" "App entfernen" 3>&1 1>&2 2>&3)

    case "$ACTION" in
        list)
            LIST=$(awk -F'|' '{printf "%-4s %-30s %s\n", $1, $2, $3}' "$APPS_LIST_FILE")
            whiptail --scrolltext --title "📋 Installierte Apps" --msgbox "ID  App                              Paket\n─────────────────────────────────────────────\n$LIST" 25 70
            ;;
        remove)
            CHOICE=$(whiptail --title "App entfernen" --menu \
                "Wähle die zu entfernende App:" 20 60 10 "${MENU_ITEMS[@]}" 3>&1 1>&2 2>&3)
            [[ -z "$CHOICE" ]] && return

            match=$(grep "^${CHOICE}|" "$APPS_LIST_FILE")
            app_name=$(echo "$match" | cut -d'|' -f2)
            pkg=$(echo "$match" | cut -d'|' -f3)
            desktop_file=$(echo "$match" | cut -d'|' -f4)

            if [[ "$pkg" != "manual" ]] && _apps_is_protected "$pkg"; then
                whiptail --msgbox "'$app_name' ($pkg) ist ein Systembestandteil und kann nicht entfernt werden." 8 60
                return
            fi

            if whiptail --yesno "Wirklich '$app_name' entfernen?" 8 50; then
                if [[ "$pkg" == "manual" ]]; then
                    rm -f "$desktop_file"
                else
                    sudo apt-get purge -y "$pkg" && sudo apt-get autoremove -y
                fi
                rm -f "$APPS_LIST_FILE"
                whiptail --msgbox "✅ '$app_name' entfernt." 8 40
            fi
            ;;
    esac
}

# ============================================================
# snowfox doctor (TUI)
# ============================================================
cmd_doctor() {
    OUTPUT=$(mktemp)

    _doc_head() { echo "▸ $1" >> "$OUTPUT"; echo "──────────────────────────" >> "$OUTPUT"; }
    _doc_ok()   { echo "✓ $1" >> "$OUTPUT"; }
    _doc_warn() { echo "⚠ $1" >> "$OUTPUT"; }
    _doc_err()  { echo "✗ $1" >> "$OUTPUT"; }
    _doc_info() { echo "  $1" >> "$OUTPUT"; }

    echo "🦊 SnowFoxOS — Doctor" >> "$OUTPUT"
    echo "─────────────────────────────────────────" >> "$OUTPUT"
    echo "" >> "$OUTPUT"

    # RAM
    _doc_head "RAM-Analyse"
    RAM_TOTAL=$(awk '/^MemTotal:/    {print int($2/1024)}' /proc/meminfo)
    RAM_FREE=$(awk  '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)
    RAM_USED=$((RAM_TOTAL - RAM_FREE))
    RAM_PCT=$(echo "scale=0; $RAM_USED * 100 / $RAM_TOTAL" | bc 2>/dev/null || echo "?")
    if [[ "$RAM_PCT" -ge 90 ]]; then
        _doc_err "RAM: ${RAM_USED}MB / ${RAM_TOTAL}MB (${RAM_PCT}%) — KRITISCH"
    elif [[ "$RAM_PCT" -ge 70 ]]; then
        _doc_warn "RAM: ${RAM_USED}MB / ${RAM_TOTAL}MB (${RAM_PCT}%) — HOCH"
    else
        _doc_ok "RAM: ${RAM_USED}MB / ${RAM_TOTAL}MB (${RAM_PCT}%)"
    fi

    SWAP_TOTAL=$(awk '/^SwapTotal:/{print int($2/1024)}' /proc/meminfo)
    SWAP_FREE=$(awk  '/^SwapFree:/ {print int($2/1024)}' /proc/meminfo)
    SWAP_USED=$((SWAP_TOTAL - SWAP_FREE))
    if [[ "$SWAP_TOTAL" -eq 0 ]]; then
        _doc_warn "Kein Swap aktiv"
    elif [[ "$SWAP_USED" -gt 0 ]]; then
        _doc_warn "Swap in Benutzung: ${SWAP_USED}MB"
    else
        _doc_ok "Swap: ${SWAP_TOTAL}MB verfügbar"
    fi

    # Treiber
    _doc_head "Treiber"
    if lspci 2>/dev/null | grep -qi nvidia; then
        if command -v nvidia-smi &>/dev/null; then
            NV_VER=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
            _doc_ok "Nvidia-Treiber installiert (v${NV_VER})"
        else
            _doc_err "Nvidia GPU erkannt, aber kein Treiber"
        fi
    elif lspci 2>/dev/null | grep -qi "AMD\|ATI"; then
        if lsmod 2>/dev/null | grep -qE "amdgpu|radeon"; then
            _doc_ok "AMD-Treiber geladen"
        else
            _doc_warn "AMD GPU erkannt, aber kein Kernelmodul"
        fi
    elif lspci 2>/dev/null | grep -qi "Intel.*Graphics"; then
        if lsmod 2>/dev/null | grep -q "i915"; then
            _doc_ok "Intel i915-Treiber geladen"
        else
            _doc_warn "Intel GPU erkannt, aber i915 nicht geladen"
        fi
    fi

    # i3
    _doc_head "i3-Konfiguration"
    if [[ -f "$HOME/.config/i3/config" ]]; then
        if command -v i3 &>/dev/null; then
            I3_ERR=$(i3 -C -c "$HOME/.config/i3/config" 2>&1)
            [[ -z "$I3_ERR" ]] && _doc_ok "i3-Config Syntax fehlerfrei" || _doc_err "Fehler in i3-Config"
        fi
    else
        _doc_err "i3-Config nicht gefunden"
    fi

    # Systemdienste
    _doc_head "Systemdienste"
    if systemctl is-active NetworkManager &>/dev/null; then
        _doc_ok "NetworkManager läuft"
    else
        _doc_err "NetworkManager läuft nicht"
    fi
    FAILED=$(systemctl --failed --no-legend 2>/dev/null | awk '{print $1}' | head -3)
    [[ -n "$FAILED" ]] && _doc_err "Fehlgeschlagene Dienste: $FAILED"

    # Festplatte
    _doc_head "Festplatte"
    DISK_PCT=$(df / | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
    DISK_FREE=$(df -h / | awk 'NR==2 {print $4}')
    if [[ "$DISK_PCT" -ge 90 ]]; then
        _doc_err "Festplatte: ${DISK_PCT}% belegt (${DISK_FREE} frei) — KRITISCH"
    elif [[ "$DISK_PCT" -ge 75 ]]; then
        _doc_warn "Festplatte: ${DISK_PCT}% belegt (${DISK_FREE} frei)"
    else
        _doc_ok "Festplatte: ${DISK_PCT}% belegt (${DISK_FREE} frei)"
    fi

    whiptail --scrolltext --title "🔬 Systemdiagnose" --msgbox "$(cat "$OUTPUT")" 30 70
    rm -f "$OUTPUT"
}

# ============================================================
# snowfox node (TUI)
# ============================================================
cmd_node() {
    CHOICE=$(whiptail --title "Node-Modus" --menu \
        "Wähle den Betriebsmodus:" 14 50 3 \
        "desktop" "Normaler i3-Desktop" \
        "server" "Server-Modus (kein X11)" \
        "console" "Console Launcher starten" 3>&1 1>&2 2>&3)

    case "$CHOICE" in
        desktop)
            if grep -q "snowfox_launcher\|SNOWFOX_NODE_CONSOLE" "$HOME/.config/i3/config" 2>/dev/null; then
                sed -i 's|^exec.*snowfox_launcher.*|#&|' "$HOME/.config/i3/config"
                sed -i 's|^exec.*SNOWFOX_NODE_CONSOLE.*|#&|' "$HOME/.config/i3/config"
            fi
            i3-msg restart
            whiptail --msgbox "✅ Desktop-Modus aktiviert." 8 40
            ;;
        server)
            if whiptail --yesno "In den Server-Modus wechseln? (X11 wird beendet)" 8 50; then
                sudo systemctl isolate multi-user.target
            fi
            ;;
        console)
            LAUNCHER="$HOME/Dokumente/SNOWFOX_NODE_CONSOLE/start.sh"
            if [[ ! -f "$LAUNCHER" ]]; then
                whiptail --msgbox "Launcher nicht gefunden: $LAUNCHER" 8 60
                return
            fi
            bash "$LAUNCHER" &
            whiptail --msgbox "✅ Console Launcher gestartet." 8 40
            ;;
    esac
}

