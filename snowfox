# Installierter Pfad der CLI-Module
CLI_DIR="/usr/local/lib/snowfox/cli"

if [[ ! -d "$CLI_DIR" ]]; then
    echo -e "\033[0;31m\033[1m[ERROR]\033[0m CLI-Module nicht gefunden in $CLI_DIR"
    echo "  Bitte snowfox neu installieren:"
    echo "    sudo cp snowfox /usr/local/bin/snowfox"
    echo "    sudo mkdir -p /usr/local/lib/snowfox/cli"
    echo "    sudo cp cli/*.sh /usr/local/lib/snowfox/cli/"
    exit 1
fi

# ── Module laden ─────────────────────────────────────────────
source "$CLI_DIR/utils.sh"
source "$CLI_DIR/status.sh"
source "$CLI_DIR/system.sh"
source "$CLI_DIR/hardware.sh"
source "$CLI_DIR/media.sh"
source "$CLI_DIR/security.sh"
source "$CLI_DIR/desktop.sh"
source "$CLI_DIR/settings.sh"
source "$CLI_DIR/doctor.sh"
source "$CLI_DIR/mesh.sh"
source "$CLI_DIR/ai.sh"
source "$CLI_DIR/tor.sh"
source "$CLI_DIR/help.sh"

# ── Dispatcher ───────────────────────────────────────────────
case "$1" in
    status)    cmd_status ;;
    battery)   cmd_battery ;;
    update)    cmd_update ;;
    reset)     function_reset_system ;;
    profile)   cmd_profile "$2" ;;
    node)      cmd_node "$2" ;;
    gpu)       cmd_gpu ;;
    kill)      cmd_kill "$2" ;;
    airmode)   cmd_airmode "$2" ;;
    download)  cmd_download "$2" ;;
    stream)    cmd_stream "${@:2}" ;;
    pass)      cmd_pass "$2" "$3" ;;
    audit)     cmd_audit ;;
    tip)       cmd_tip ;;
    autostart) cmd_start "$2" "$3" ;;
    layout)    cmd_layout "$2" ;;
    apps)      cmd_apps "$2" "$3" ;;
    webapp)    cmd_webapp "$2" "$3" "$4" ;;
    settings)  shift; cmd_settings "$@" ;;
    doctor)    cmd_doctor ;;
    mesh)      shift; cmd_mesh_wrapper "$@" ;;
    ai)        cmd_ai ;;
    tor)       cmd_tor "$2" ;;
    network)   exec ~/.config/snowfox-network.sh ;;
    help|"")   cmd_help ;;
    *)
        err "Unbekannter Befehl: $1"
        echo -e "  Hilfe: ${CYAN}snowfox help${RESET}"
        exit 1
        ;;
esac
