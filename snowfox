# ============================================================
# snowfox status (TUI)
# ============================================================
cmd_status() {
    UPTIME=$(uptime -p | sed 's/up //')
    RAM_TOTAL=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)
    RAM_FREE=$(awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo)
    RAM_USED=$((RAM_TOTAL - RAM_FREE))
    DISK_USED=$(df -h / | awk 'NR==2 {print $3}')
    DISK_TOTAL=$(df -h / | awk 'NR==2 {print $2}')
    DISK_FREE=$(df -h / | awk 'NR==2 {print $4}')
    CPU=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs)
    GPU_MODE=$(envycontrol --query 2>/dev/null || echo "unbekannt")
    IP=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')
    IFACE=$(ip route get 1.1.1.1 2>/dev/null | awk '{print $5; exit}')
    [[ -z "$IP" ]] && IP="nicht verbunden"
    AIRMODE=$(rfkill list all 2>/dev/null | grep -q "blocked: yes" && echo "AKTIV" || echo "aus")
    MIC_ID=$(pactl list sources short 2>/dev/null | grep -v monitor | awk '{print $1}' | head -1)
    if [[ -n "$MIC_ID" ]]; then
        MIC_MUTE=$(pactl get-source-mute "$MIC_ID" 2>/dev/null | awk '{print $2}')
        MIC_STATUS=$([ "$MIC_MUTE" == "yes" ] && echo "deaktiviert" || echo "aktiv")
    else
        MIC_STATUS="keines gefunden"
    fi
    CAM=$(ls /dev/video* &>/dev/null && echo "verfügbar" || echo "keine gefunden")
    PROFILE=$(cat "$HOME/.config/snowfox/profile" 2>/dev/null || echo "balanced")

    whiptail --title "🦊 SnowFoxOS — System Status" --msgbox \
        "Uptime:     $UPTIME\n\
RAM:        ${RAM_USED}MB used / ${RAM_TOTAL}MB total\n\
Disk:       ${DISK_USED} used / ${DISK_TOTAL} total (${DISK_FREE} free)\n\
CPU:        $CPU\n\
GPU-Modus:  $GPU_MODE\n\
Netzwerk:   $IP ($IFACE)\n\
Airmode:    $AIRMODE\n\
Mikrofon:   $MIC_STATUS\n\
Kamera:     $CAM\n\
Profil:     $PROFILE" 20 60
}

# ============================================================
# snowfox update (TUI)
# ============================================================
cmd_update() {
    REPO_DIR=""
    for candidate in "$HOME/SnowFoxOS-v3" "$HOME/SnowFoxOS" "/opt/snowfoxos"; do
        [[ -d "$candidate/.git" ]] && REPO_DIR="$candidate" && break
    done

    if [[ -z "$REPO_DIR" ]]; then
        REPO_DIR=$(whiptail --inputbox "Repo-Verzeichnis nicht gefunden.\nPfad zum SnowFoxOS-Repo:" 10 60 3>&1 1>&2 2>&3)
        [[ -z "$REPO_DIR" ]] && return
        [[ ! -d "$REPO_DIR/.git" ]] && whiptail --msgbox "Kein Git-Repo gefunden in: $REPO_DIR" 8 60 && return
    fi

    CHOICE=$(whiptail --title "SnowFoxOS — System Update" --menu \
        "Wähle die Update-Art:" 15 60 2 \
        "1" "Nur Pakete aktualisieren (apt)" \
        "2" "Alles — Repo + Configs + CLI + Pakete" 3>&1 1>&2 2>&3)

    case "$CHOICE" in
        1)
            whiptail --msgbox "Pakete werden aktualisiert..." 8 40 &
            sudo apt-get update -qq
            sudo apt-get upgrade -y
            sudo apt-get autoremove -y
            sudo apt-get autoclean -y
            if command -v yt-dlp &>/dev/null; then
                sudo curl -sL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
                    -o /usr/local/bin/yt-dlp && sudo chmod +x /usr/local/bin/yt-dlp
            fi
            whiptail --msgbox "✅ Pakete sind aktuell." 8 40
            ;;
        2)
            whiptail --msgbox "Repo wird aktualisiert: $REPO_DIR" 8 60
            cd "$REPO_DIR" || return
            LOCAL=$(git rev-parse HEAD 2>/dev/null)
            git pull --ff-only 2>&1 | whiptail --scrolltext --title "Git Pull" --msgbox - 20 60
            REMOTE=$(git rev-parse HEAD 2>/dev/null)

            BACKUP_DIR="$HOME/.snowfox-backup/$(date +%Y%m%d_%H%M%S)"
            mkdir -p "$BACKUP_DIR"
            for dir in i3 polybar rofi dunst kitty; do
                [[ -e "$HOME/.config/$dir" ]] && cp -r "$HOME/.config/$dir" "$BACKUP_DIR/"
            done
            [[ -f /usr/local/bin/snowfox ]] && cp /usr/local/bin/snowfox "$BACKUP_DIR/snowfox.bak"
            [[ -f "$HOME/.config/snowfox-mesh.sh" ]] && cp "$HOME/.config/snowfox-mesh.sh" "$BACKUP_DIR/snowfox-mesh.bak"

            sudo cp "$REPO_DIR/snowfox" /usr/local/bin/snowfox
            sudo chmod +x /usr/local/bin/snowfox

            if [[ -d "$REPO_DIR/configs" ]]; then
                cp -r "$REPO_DIR/configs/"* "$HOME/.config/"
                i3-msg reload &>/dev/null
                if pgrep -x polybar &>/dev/null; then
                    pkill polybar
                    sleep 0.5
                    bash "$HOME/.config/polybar/launch.sh" &
                fi
            fi

            MESH_SCRIPT_SRC="$REPO_DIR/configs/snowfox-mesh.sh"
            MESH_SCRIPT_DST="$HOME/.config/snowfox-mesh.sh"
            [[ -f "$MESH_SCRIPT_SRC" ]] && cp "$MESH_SCRIPT_SRC" "$MESH_SCRIPT_DST" && chmod +x "$MESH_SCRIPT_DST"

            sudo apt-get update -qq
            sudo apt-get upgrade -y
            sudo apt-get autoremove -y

            if command -v yt-dlp &>/dev/null; then
                sudo curl -sL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
                    -o /usr/local/bin/yt-dlp && sudo chmod +x /usr/local/bin/yt-dlp
            fi

            if command -v pipx &>/dev/null && pipx list 2>/dev/null | grep -q rns; then
                pipx upgrade rns 2>/dev/null
            elif command -v pip3 &>/dev/null; then
                pip3 install --upgrade rns --break-system-packages 2>/dev/null
            fi

            whiptail --msgbox "✅ System vollständig aktualisiert.\nBackup: $BACKUP_DIR" 12 60
            ;;
        *)
            return
            ;;
    esac
}

# ============================================================
# snowfox gpu (TUI)
