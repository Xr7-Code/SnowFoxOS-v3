PROFILE_FILE="$HOME/.config/snowfox/profile"

cmd_profile() {
    mkdir -p "$HOME/.config/snowfox"
    CURRENT=$(cat "$PROFILE_FILE" 2>/dev/null || echo "balanced")

    CHOICE=$(whiptail --title "Profil wechseln" --menu \
        "Aktuelles Profil: $CURRENT\n\nWähle ein Profil:" 16 60 4 \
        "balanced" "Standard, ausgewogen" \
        "performance" "Maximale CPU-Leistung" \
        "battery" "Akku sparen, CPU gedrosselt" \
        "privacy" "Kein Funk, maximale Isolation" 3>&1 1>&2 2>&3)

    [[ -z "$CHOICE" ]] && return

    echo "$CHOICE" > "$PROFILE_FILE"
    case "$CHOICE" in
        performance)
            echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor &>/dev/null || true
            sudo sysctl -w vm.swappiness=10 &>/dev/null
            pkill redshift 2>/dev/null || true
            whiptail --msgbox "✅ Profil: Performance\nCPU-Governor: performance | swappiness: 10" 10 50
            ;;
        battery)
            echo powersave | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor &>/dev/null || true
            sudo sysctl -w vm.swappiness=60 &>/dev/null
            pkill redshift 2>/dev/null || true
            redshift -l 48.3:14.3 &>/dev/null &
            whiptail --msgbox "✅ Profil: Battery\nCPU-Governor: powersave | swappiness: 60" 10 50
            ;;
        privacy)
            sudo rfkill block wifi bluetooth &>/dev/null || true
            pkill redshift 2>/dev/null || true
            whiptail --msgbox "✅ Profil: Privacy\nWiFi: aus | Bluetooth: aus\nFunk: blockiert" 10 50
            ;;
        balanced)
            echo schedutil | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor &>/dev/null || true
            sudo sysctl -w vm.swappiness=10 &>/dev/null
            sudo rfkill unblock all &>/dev/null || true
            pkill redshift 2>/dev/null || true
            redshift -l 48.3:14.3 &>/dev/null &
            whiptail --msgbox "✅ Profil: Balanced\nCPU-Governor: schedutil | swappiness: 10" 10 50
            ;;
    esac
}

# ============================================================
# snowfox autostart (TUI)
# ============================================================
I3_CONFIG="$HOME/.config/i3/config"

cmd_start() {
    if [[ ! -f "$I3_CONFIG" ]]; then
        whiptail --msgbox "i3-Config nicht gefunden: $I3_CONFIG" 8 60
        return
    fi

    ENTRIES=$(grep -n "^exec " "$I3_CONFIG" 2>/dev/null)
    DISABLED=$(grep -n "^#exec " "$I3_CONFIG" 2>/dev/null)

    MENU_ITEMS=()
    while IFS= read -r entry; do
        CMD=$(echo "$entry" | cut -d: -f2- | sed 's/^exec //')
        MENU_ITEMS+=("$CMD" "AN")
    done <<< "$ENTRIES"
    while IFS= read -r entry; do
        CMD=$(echo "$entry" | cut -d: -f2- | sed 's/^#exec //')
        MENU_ITEMS+=("$CMD" "AUS")
    done <<< "$DISABLED"

    if [[ ${#MENU_ITEMS[@]} -eq 0 ]]; then
        whiptail --msgbox "Keine Autostart-Einträge gefunden." 8 40
        return
    fi

    CHOICE=$(whiptail --title "Autostart Programme" --menu \
        "Wähle ein Programm zum Aktivieren/Deaktivieren:" 20 60 10 "${MENU_ITEMS[@]}" 3>&1 1>&2 2>&3)

    [[ -z "$CHOICE" ]] && return

    if grep -q "^exec.*$CHOICE" "$I3_CONFIG"; then
        if whiptail --yesno "'$CHOICE' deaktivieren?" 8 50; then
            sed -i "s|^exec \(.*$CHOICE.*\)|#exec \1|" "$I3_CONFIG"
            i3-msg reload &>/dev/null || true
            whiptail --msgbox "✅ $CHOICE deaktiviert." 8 40
        fi
    elif grep -q "^#exec.*$CHOICE" "$I3_CONFIG"; then
        if whiptail --yesno "'$CHOICE' aktivieren?" 8 50; then
            sed -i "s|^#exec \(.*$CHOICE.*\)|exec \1|" "$I3_CONFIG"
            i3-msg reload &>/dev/null || true
            whiptail --msgbox "✅ $CHOICE aktiviert." 8 40
        fi
    fi
}

# ============================================================
# snowfox layout (TUI)
# ============================================================
cmd_layout() {
    if grep -q '^for_window \[class=".*"\] floating enable' ~/.config/i3/config 2>/dev/null; then
        CURRENT="Floating"
    else
        CURRENT="Tiling"
    fi

    CHOICE=$(whiptail --title "Layout wechseln" --menu \
        "Aktuelles Layout: $CURRENT\n\nWähle das neue Layout:" 14 50 2 \
        "tiling" "Fenster nebeneinander (i3-Standard)" \
        "floating" "Fenster schwebend (klassischer Desktop)" 3>&1 1>&2 2>&3)

    case "$CHOICE" in
        tiling)
            i3-msg "workspace_layout default" &>/dev/null
            i3-msg "[class=\".*\"] floating disable" &>/dev/null || true
            sed -i 's/^for_window \[class=".*"\] floating enable/# for_window [class=".*"] floating enable/' \
                ~/.config/i3/config 2>/dev/null || true
            i3-msg reload &>/dev/null
            whiptail --msgbox "✅ Layout: Tiling\nNeue Fenster werden nebeneinander angeordnet." 10 50
            ;;
        floating)
            if grep -q 'for_window \[class=".*"\] floating enable' ~/.config/i3/config 2>/dev/null; then
                sed -i 's/^# for_window \[class=".*"\] floating enable/for_window [class=".*"] floating enable/' \
                    ~/.config/i3/config
            else
                echo 'for_window [class=".*"] floating enable' >> ~/.config/i3/config
            fi
            i3-msg reload &>/dev/null
            whiptail --msgbox "✅ Layout: Floating\nNeue Fenster schweben frei." 10 50
            ;;
    esac
}

