cmd_airmode() {
    CHOICE=$(whiptail --title "Airmode" --menu \
        "Funkverbindungen verwalten:" 12 50 3 \
        "on" "Alle Funkverbindungen deaktivieren" \
        "off" "Alle Funkverbindungen reaktivieren" \
        "status" "Status anzeigen" 3>&1 1>&2 2>&3)

    case "$CHOICE" in
        on)  sudo rfkill block all && whiptail --msgbox "✅ Airmode aktiviert — alle Funkverbindungen deaktiviert." 8 50 ;;
        off) sudo rfkill unblock all && whiptail --msgbox "✅ Airmode deaktiviert — Funkverbindungen reaktiviert." 8 50 ;;
        status)
            if rfkill list all 2>/dev/null | grep -q "blocked: yes"; then
                whiptail --msgbox "⚠️ Airmode ist AKTIV — Funk deaktiviert." 8 50
            else
                whiptail --msgbox "✅ Airmode ist AUS — Funk aktiv." 8 50
            fi
            ;;
    esac
}

# ============================================================
# snowfox kill (TUI)
# ============================================================
cmd_kill() {
    CHOICE=$(whiptail --title "Hardware deaktivieren" --menu \
        "Wähle die zu deaktivierende Hardware:" 14 50 4 \
        "mic" "Mikrofon deaktivieren" \
        "cam" "Kamera deaktivieren" \
        "all" "Alles deaktivieren (Schweige-Modus)" \
        "restore" "Alles reaktivieren" 3>&1 1>&2 2>&3)

    case "$CHOICE" in
        mic)
            MIC_ID=$(pactl list sources short 2>/dev/null | grep -v monitor | awk '{print $1}' | head -1)
            [[ -z "$MIC_ID" ]] && whiptail --msgbox "Kein Mikrofon gefunden." 8 40 && return
            pactl set-source-mute "$MIC_ID" 1 2>/dev/null
            whiptail --msgbox "✅ Mikrofon deaktiviert." 8 40
            ;;
        cam)
            if ls /dev/video* &>/dev/null; then
                sudo modprobe -r uvcvideo 2>/dev/null
                whiptail --msgbox "✅ Kamera deaktiviert." 8 40
            else
                whiptail --msgbox "Keine Kamera gefunden." 8 40
            fi
            ;;
        all)
            MIC_ID=$(pactl list sources short 2>/dev/null | grep -v monitor | awk '{print $1}' | head -1)
            [[ -n "$MIC_ID" ]] && pactl set-source-mute "$MIC_ID" 1 2>/dev/null
            sudo modprobe -r uvcvideo 2>/dev/null
            sudo rfkill block all
            whiptail --msgbox "✅ Gerät ist jetzt im vollständigen Schweige-Modus." 8 50
            ;;
        restore)
            MIC_ID=$(pactl list sources short 2>/dev/null | grep -v monitor | awk '{print $1}' | head -1)
            [[ -n "$MIC_ID" ]] && pactl set-source-mute "$MIC_ID" 0 2>/dev/null
            sudo modprobe uvcvideo 2>/dev/null
            sudo rfkill unblock all
            whiptail --msgbox "✅ Alle Hardware reaktiviert." 8 40
            ;;
    esac
}

# ============================================================
# snowfox download (TUI)
# ============================================================
cmd_download() {
    if ! command -v yt-dlp &>/dev/null; then
        whiptail --msgbox "yt-dlp nicht gefunden.\nInstallieren: sudo apt install yt-dlp" 8 50
        return
    fi

    URL=$(whiptail --inputbox "URL zum Herunterladen:" 10 60 3>&1 1>&2 2>&3)
    [[ -z "$URL" ]] && return

    FORMAT=$(whiptail --title "Format wählen" --menu \
        "Wähle das Format:" 12 60 3 \
        "1" "Video (beste Qualität)" \
        "2" "Nur Audio (mp3)" \
        "3" "Nur Audio (opus, kleiner)" 3>&1 1>&2 2>&3)

    OUTDIR="$HOME/Downloads"
    mkdir -p "$OUTDIR"

    case "$FORMAT" in
        1) yt-dlp -o "$OUTDIR/%(title)s.%(ext)s" "$URL" ;;
        2) yt-dlp -x --audio-format mp3 -o "$OUTDIR/%(title)s.%(ext)s" "$URL" ;;
        3) yt-dlp -x --audio-format opus -o "$OUTDIR/%(title)s.%(ext)s" "$URL" ;;
        *) return ;;
    esac

    whiptail --msgbox "✅ Gespeichert in: $OUTDIR" 8 50
}

# ============================================================
# snowfox stream (TUI)
# ============================================================
cmd_stream() {
    if ! command -v mpv &>/dev/null; then
        whiptail --msgbox "mpv nicht gefunden.\nInstallieren: sudo apt install mpv" 8 50
        return
    fi

    QUERY=$(whiptail --inputbox "Suche (Video/Musik) oder URL:" 10 60 3>&1 1>&2 2>&3)
    [[ -z "$QUERY" ]] && return

    if [[ ! "$QUERY" =~ ^http ]]; then
        mapfile -t RESULTS < <(yt-dlp --print "%(title)s|%(id)s" --flat-playlist "ytsearch5:$QUERY" 2>/dev/null)
        if [[ ${#RESULTS[@]} -eq 0 ]]; then
            whiptail --msgbox "Keine Ergebnisse gefunden." 8 40
            return
        fi

        MENU_ITEMS=()
        for i in "${!RESULTS[@]}"; do
            title=$(echo "${RESULTS[$i]}" | cut -d'|' -f1)
            MENU_ITEMS+=("$((i+1))" "$title")
        done

        CHOICE=$(whiptail --title "Ergebnisse" --menu "Wähle ein Video:" 20 60 5 "${MENU_ITEMS[@]}" 3>&1 1>&2 2>&3)
        [[ -z "$CHOICE" ]] && return

        ID=$(echo "${RESULTS[$((CHOICE-1))]}" | cut -d'|' -f2)
        URL="https://www.youtube.com/watch?v=$ID"
    else
        URL="$QUERY"
    fi

    whiptail --msgbox "Starte Stream...\n\nDrücke OK um fortzufahren.\nZum Beenden: 'q' drücken im mpv-Fenster." 10 50
    mpv --ytdl "$URL"
}

# ============================================================
# snowfox pass (TUI)
# ============================================================
PASS_FILE="$HOME/.config/snowfox/.passwords"
PASS_DIR="$HOME/.config/snowfox"

cmd_pass() {
    mkdir -p "$PASS_DIR"
    chmod 700 "$PASS_DIR"

    if ! command -v gpg &>/dev/null; then
        whiptail --msgbox "gpg nicht gefunden.\nInstallieren: sudo apt install gnupg" 8 50
        return
    fi

    ACTION=$(whiptail --title "Passwort-Manager" --menu \
        "Wähle eine Aktion:" 15 50 4 \
        "add" "Passwort speichern" \
        "get" "Passwort in Clipboard kopieren" \
        "list" "Alle Einträge anzeigen" \
        "remove" "Eintrag löschen" 3>&1 1>&2 2>&3)

    case "$ACTION" in
        add)
            NAME=$(whiptail --inputbox "Name für den Eintrag:" 10 60 3>&1 1>&2 2>&3)
            [[ -z "$NAME" ]] && return
            PASS=$(whiptail --passwordbox "Passwort für '$NAME':" 10 60 3>&1 1>&2 2>&3)
            [[ -z "$PASS" ]] && return
            ENCRYPTED=$(echo "$PASS" | gpg --symmetric --armor -q 2>/dev/null)
            if [[ -z "$ENCRYPTED" ]]; then
                whiptail --msgbox "Verschlüsselung fehlgeschlagen." 8 40
                return
            fi
            echo "$NAME:$ENCRYPTED" >> "$PASS_FILE"
            chmod 600 "$PASS_FILE"
            whiptail --msgbox "✅ Passwort für '$NAME' gespeichert." 8 40
            ;;
        get)
            if [[ ! -f "$PASS_FILE" ]]; then
                whiptail --msgbox "Keine Passwörter gespeichert." 8 40
                return
            fi
            NAMES=$(grep -oP '^[^:]+' "$PASS_FILE" 2>/dev/null | tr '\n' ' ')
            NAME=$(whiptail --inputbox "Name des Eintrags:\n\nVorhanden: $NAMES" 12 60 3>&1 1>&2 2>&3)
            [[ -z "$NAME" ]] && return
            ENTRY=$(grep "^$NAME:" "$PASS_FILE" | cut -d: -f2-)
            if [[ -z "$ENTRY" ]]; then
                whiptail --msgbox "Kein Eintrag für '$NAME' gefunden." 8 40
                return
            fi
            DECRYPTED=$(echo "$ENTRY" | gpg --decrypt -q 2>/dev/null)
            echo -n "$DECRYPTED" | xclip -selection clipboard 2>/dev/null || \
                echo -n "$DECRYPTED" | xsel --clipboard --input 2>/dev/null
            whiptail --msgbox "✅ Passwort für '$NAME' in die Zwischenablage kopiert." 8 40
            ;;
        list)
            if [[ ! -f "$PASS_FILE" ]]; then
                whiptail --msgbox "Keine Passwörter gespeichert." 8 40
                return
            fi
            LIST=$(grep -oP '^[^:]+' "$PASS_FILE" | nl -w2 -s'. ')
            whiptail --msgbox "📋 Gespeicherte Einträge:\n\n$LIST" 20 50
            ;;
        remove)
            if [[ ! -f "$PASS_FILE" ]]; then
                whiptail --msgbox "Keine Passwörter gespeichert." 8 40
                return
            fi
            NAME=$(whiptail --inputbox "Name des zu löschenden Eintrags:" 10 60 3>&1 1>&2 2>&3)
            [[ -z "$NAME" ]] && return
            if ! grep -q "^$NAME:" "$PASS_FILE"; then
                whiptail --msgbox "Kein Eintrag für '$NAME' gefunden." 8 40
                return
            fi
            sed -i "/^$NAME:/d" "$PASS_FILE"
            whiptail --msgbox "✅ Eintrag '$NAME' entfernt." 8 40
            ;;
    esac
}

